<resources>
    <style name="Theme.Pyx" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/pyx_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Pyx.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pyx_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pyx</item>
    </style>
</resources>
